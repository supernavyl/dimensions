# Godot 4 standard gitignore

# Godot-specific ignores
.godot/
*.translation

# Import metadata — regenerated by editor, never commit
*.import

# Godot UID files — generated automatically, never create or modify manually
*.uid

# Exported binaries
export/
builds/

# OS generated
.DS_Store
Thumbs.db

# Editor configuration overrides (local only)
.editorconfig.local
